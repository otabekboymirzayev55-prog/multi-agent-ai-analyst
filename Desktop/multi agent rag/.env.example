# Copy this file to ".env" and fill in your OWN keys.
# Never commit the real ".env" file to GitHub.

# Required — the key your mentor gave you for the proxy
GEMINI_API_KEY=

# Optional — Feature 4 (web agent). Free tier: https://tavily.com
TAVILY_API_KEY=

# Optional — Feature 12 (observability). Free tier: https://cloud.langfuse.com
# Sign up, create a project, copy the keys from Settings → API Keys
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
